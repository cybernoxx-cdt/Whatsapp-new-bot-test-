# Copy to .env and fill in real values. Never commit a filled-in .env.
# Required
BOT_NUMBER=947XXXXXXXX
SESSION_ID=<base64 session export, creds.json content, or MEGA link>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Call media (direct, publicly downloadable media URLs)
DEFAULT_AUDIO_URL=https://example.com/audio.mp3
DEFAULT_VIDEO_URL=https://example.com/video.mp4
# Optional
SESSION_ID_2=
BOT_NUMBER_2=
MOVIE_API_KEY=
PINTEREST_API_KEY=
WHATSAPP_GQL_TOKEN=
WHATSAPP_GQL_DOC_ID=
SESSION_ENCRYPTION_KEY=<base64-encoded 32-byte key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
CALL_LIMIT=10
TMP_DIR=./tmp
PORT=3000
