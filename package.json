{
  "name": "god-voip-md",
  "version": "1.0.0",
  "description": "GOD VOIP MD - WhatsApp VoIP bot with validated media handling and defensive media security. Media is validated with ffprobe before use.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node multi-session.js",
    "syntax-check": "find . -path './node_modules' -prune -o -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "security-check": "node scripts/security-check.mjs",
    "test": "node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "voip",
    "baileys",
    "call-bot",
    "nodejs"
  ],
  "author": "Savendra",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@dnuzi/baileys": "0.1.4",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "jimp": "^1.6.1",
    "pino": "^8.16.1",
    "sharp": "^0.34.5",
    "megajs": "^1.3.0",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
